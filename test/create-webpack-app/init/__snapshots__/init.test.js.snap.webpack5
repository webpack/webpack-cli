    output: {
        path: path.resolve(__dirname, "dist"),
    },
    devServer: {
        open: true,
    },
    // vue-loader rewrites \`module.rules\`, which hides from webpack that no rule
    // handles \`.html\`/\`.css\` — so ask for the built-in support explicitly
    experiments: {
        css: true,
        html: true,
    },
    plugins: [
